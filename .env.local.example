# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS committer .env.local dans git

# Supabase — obtenir sur https://supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_ici
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# Clé secrète pour protéger le cron endpoint
CRON_SECRET=choisir_une_chaine_aleatoire_longue
